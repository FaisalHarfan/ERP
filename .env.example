# ─── UnityERP Server Configuration ───
# Salin file ini ke .env dan isi nilainya. JANGAN commit .env ke git.

# Server
PORT=3000
NODE_ENV=production

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unity
DB_USER=postgres
DB_PASSWORD=isi_password_database_anda

# JWT Authentication
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# WAJIB diisi — server akan crash jika kosong atau masih default
JWT_SECRET=ganti_dengan_string_acak_minimal_64_karakter
JWT_EXPIRES_IN=8h

# CORS — URL frontend yang diizinkan akses API
# Pisahkan dengan koma jika lebih dari satu: http://localhost:3000,https://erp.domain.com
CORS_ORIGIN=http://localhost:3000
